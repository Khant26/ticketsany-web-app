# TicketsAnywhere API - example environment. Copy to .env (git-ignored) for
# local development, or set these as environment variables in production.

# --- Core -------------------------------------------------------------------
# Required when DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
# Comma-separated host names this API answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Leave empty to use SQLite (db.sqlite3 or SQLITE_PATH); use PostgreSQL in production:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DB_SSL_REQUIRE=False
# SQLITE_PATH=/data/db.sqlite3

# --- CORS / CSRF ------------------------------------------------------------
# Comma-separated origins of the web app (customer site + /admin), no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional, e.g. ^https://.*\.vercel\.app$ to allow Vercel preview deployments.
CORS_ALLOWED_ORIGIN_REGEXES=
# Defaults to the value of DEBUG.
# CORS_ALLOW_ALL_ORIGINS=False
# Legacy single-origin settings (still supported, merged into CORS_ALLOWED_ORIGINS).
FRONTEND_URL=
ADMIN_URL=
# Needed for the Django admin login over HTTPS, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

# --- Email (OTP verification / password reset) ------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Cloudinary (event / banner / category images) --------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Container / Gunicorn ---------------------------------------------------
PORT=8000
# Set to 1 to run "migrate" when the container starts.
RUN_MIGRATIONS=0
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
