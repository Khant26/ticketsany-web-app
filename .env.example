# Copy to .env.local (never commit real .env files).
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so never put secrets (passwords, private keys) in VITE_* variables.

# Base URL of the Django REST API, including the /api/ prefix.
# Used by both the customer site (/) and the admin dashboard (/admin).
# Local dev default if unset: http://127.0.0.1:8000/api/
VITE_API_BASE_URL=http://127.0.0.1:8000/api/

# Optional request tuning
# VITE_API_TIMEOUT=10000
# VITE_RETRY_ATTEMPTS=3
